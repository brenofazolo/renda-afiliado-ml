# Mercado Livre OAuth
# Nunca faça commit do arquivo .env real.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://example.com/callback
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# Preenchido automaticamente após a primeira renovação.
MELI_TOKEN_EXPIRES_AT=

MELI_SITE_ID=MLB

# Busca padrão do MVP
MELI_QUERY=air fryer
MELI_LIMIT=20

# Acesso à interface web piloto (defina valores fortes no .env real)
WEB_USERNAME=
WEB_PASSWORD=
WEB_SECRET_KEY=
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_THREADS=6
WEB_HTTPS_ONLY=false
WEB_DATABASE_PATH=
WEB_SEARCH_SUGGESTIONS=air fryer,perfume feminino,perfume masculino,smartwatch,ferramentas,beleza,casa e cozinha,eletrônicos
